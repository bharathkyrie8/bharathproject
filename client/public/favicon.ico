<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <circle cx="32" cy="32" r="30" fill="#0E1014" stroke="#C59A5A" stroke-width="2.5"/>
  <!-- Front Wheel -->
  <circle cx="45" cy="40" r="11" fill="none" stroke="#C59A5A" stroke-width="2"/>
  <circle cx="45" cy="40" r="2" fill="#C59A5A"/>
  <!-- Back Wheel -->
  <circle cx="19" cy="40" r="11" fill="none" stroke="#C59A5A" stroke-width="2"/>
  <circle cx="19" cy="40" r="2" fill="#C59A5A"/>
  <!-- Frame -->
  <polyline points="19,40 29,40 38,28 45,40" fill="none" stroke="#FAF7F2" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
  <polyline points="29,40 31,24 23,24" fill="none" stroke="#FAF7F2" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
  <line x1="38" y1="28" x2="31" y2="24" stroke="#FAF7F2" stroke-width="2.2" stroke-linecap="round"/>
  <line x1="45" y1="40" x2="42" y2="20" stroke="#C59A5A" stroke-width="2.2" stroke-linecap="round"/>
  <!-- Handlebars -->
  <polyline points="40,20 44,20 45,23" fill="none" stroke="#C59A5A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
  <!-- Seat -->
  <line x1="21" y1="23" x2="26" y2="23" stroke="#C59A5A" stroke-width="3" stroke-linecap="round"/>
</svg>
